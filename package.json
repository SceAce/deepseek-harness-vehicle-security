{
  "name": "dsh-vehicle-security",
  "version": "0.2.0",
  "description": "Evidence-driven vehicle-security investigation, program, and protocol tools for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tools": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./skills": {
      "types": "./lib/skills.d.ts",
      "default": "./lib/skills.js"
    },
    "./ctf-tools": {
      "types": "./lib/ctf/index.d.ts",
      "default": "./lib/ctf/index.js"
    },
    "./ctf-skills": {
      "types": "./lib/ctf/skills.d.ts",
      "default": "./lib/ctf/skills.js"
    }
  },
  "files": [
    "lib",
    "codex-plugin/plugins/vehicle-security",
    "codex-plugin/plugins/ctf-security",
    "cordis.patch.yml",
    "cordis.ctf.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:harness": "tsc -p tsconfig.json",
    "build:codex": "node scripts/sync-codex-runtime.mjs",
    "build": "pnpm run build:harness && pnpm run build:codex",
    "test": "pnpm run build && node --test",
    "check": "tsc -p tsconfig.json --noEmit && node --check scripts/sync-codex-runtime.mjs && node --check codex-plugin/plugins/vehicle-security/skills/analyze-vehicle-security/scripts/vehicle_security.mjs && node --check codex-plugin/plugins/vehicle-security/mcp/server.mjs && node --check codex-plugin/plugins/ctf-security/mcp/server.mjs",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.0-rc.6",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "vehicle-security",
    "program-analysis",
    "reverse-engineering",
    "can-bus",
    "uds",
    "firmware",
    "ctf",
    "pwn",
    "crypto",
    "misc",
    "web-security"
  ],
  "license": "MIT"
}
